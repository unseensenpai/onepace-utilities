{
  "manifest_version": 3,
  "name": "OnePace Utilities",
  "version": "0.4.0",
  "description": "Arc Master, izleme ilerlemesi ve oynatıcı ayarları için OnePaceTR, AnimPow ve TRanimeizle yardımcı eklentisi.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "OnePace Utilities",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "permissions": ["storage", "webNavigation", "declarativeNetRequest", "scripting"],
  "host_permissions": [
    "https://www.onepacetr.net/*",
    "https://animpow.com/*",
    "*://*.abyssplayer.com/*",
    "*://*.sibnet.ru/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.onepacetr.net/*"],
      "js": ["src/shared/backup.js", "src/content/content.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://animpow.com/*"],
      "js": ["src/shared/animpow-core.js", "src/shared/one-piece-titles.js", "src/content/animpow.js"],
      "css": ["src/content/animpow.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tranimeizle.live/*", "https://www.tranimeizle.io/*"],
      "js": ["src/shared/animpow-core.js", "src/shared/one-piece-titles.js", "src/shared/tranime-core.js", "src/content/tranime.js"],
      "css": ["src/content/animpow.css", "src/content/tranime.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.abyssplayer.com/*",
        "*://*.sibnet.ru/*",
        "https://drive.google.com/*",
        "*://*.optraco.top/*",
        "*://*.mail.ru/*",
        "*://*.mixdrop.co/*",
        "*://*.mixdrop.ag/*",
        "*://*.vidmoly.to/*",
        "*://*.vidmoly.me/*",
        "*://*.vudeo.co/*",
        "*://*.vudeo.net/*",
        "*://*.yourupload.com/*",
        "*://*.mega.nz/*"
      ],
      "js": ["src/content/jwplayer-bridge.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.abyssplayer.com/*",
        "*://*.sibnet.ru/*",
        "https://drive.google.com/*",
        "*://*.optraco.top/*",
        "*://*.mail.ru/*",
        "*://*.mixdrop.co/*",
        "*://*.mixdrop.ag/*",
        "*://*.vidmoly.to/*",
        "*://*.vidmoly.me/*",
        "*://*.vudeo.co/*",
        "*://*.vudeo.net/*",
        "*://*.yourupload.com/*",
        "*://*.mega.nz/*"
      ],
      "js": ["src/content/player-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
