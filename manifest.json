{
  "manifest_version": 3,
  "name": "OnePace Utilities",
  "version": "0.2.0",
  "description": "Arc Master, izleme ilerlemesi ve oynatıcı ayarları için OnePaceTR yardımcı eklentisi.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "OnePace Utilities",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "https://www.onepacetr.net/*",
    "*://*.abyssplayer.com/*",
    "*://*.sibnet.ru/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.onepacetr.net/*"],
      "js": ["src/shared/backup.js", "src/content/content.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.abyssplayer.com/*", "*://*.sibnet.ru/*", "https://drive.google.com/*"],
      "js": ["src/content/player-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
